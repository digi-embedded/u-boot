/dts-v1/;

#include <dt-bindings/phy/phy-imx8-pcie.h>
#include <dt-bindings/regulator/nxp,pf09-regulator.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/usb/pd.h>
/* i.MX95 CPU */
#include "imx95.dtsi"
/* Digi ConnectCore 95 (SOM) */
#include "ccimx95.dtsi"
/* Digi ConnectCore 95 SMARC card for SOM */
#include "ccimx95-smarc.dtsi"

/ {
	model = "Digi International ConnectCore 95 DVK";
	compatible = "digi,ccimx95-dvk", "digi,ccimx95", "fsl,imx95-19x19-evk", "fsl,imx95";
	digi,machine,name = "ccimx95-dvk";

	aliases {
		ethernet0 = &enetc_port0;
		ethernet1 = &enetc_port1;
	};

	chosen {
		stdout-path = &lpuart1;
	};

	hdmi_connector: hdmi-connector {
		compatible = "hdmi-connector";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_hdmi_hpd>;
		ddc-i2c-bus = <&lpi2c2>;
		hdmi-pwr-supply = <&reg_5v_board>;
		hpd-gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;
		label = "hdmi";
		type = "a";
		status = "disabled";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&lt8912_out>;
			};
		};
	};

	lvds0_backlight: lvds0-backlight {
		compatible = "gpio-backlight";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_lvds0_backlight>;
		gpios = <&gpio2 5 GPIO_ACTIVE_HIGH>;
		default-on;
		status = "okay";
	};

	lvds0_panel {
		compatible = "simple-panel";
		backlight = <&lvds0_backlight>;
		power-supply = <&reg_5v_board>;
		status = "okay";

		display-timings {
			native-mode = <&timing0>;

			timing0: timing0 {
				clock-frequency = <71143000>;
				hactive = <1280>;
				vactive = <800>;
				hfront-porch = <120>;
				hback-porch = <2>;
				hsync-len = <8>;
				vback-porch = <10>;
				vfront-porch = <2>;
				vsync-len = <6>;
				hsync-active = <1>;
				vsync-active = <1>;
			};
		};

		port {
			panel_lvds0_in: endpoint {
				remote-endpoint = <&lvds0_out>;
			};
		};
	};

	lvds1_backlight: lvds1-backlight {
		compatible = "gpio-backlight";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_lvds1_backlight>;
		gpios = <&gpio2 4 GPIO_ACTIVE_HIGH>;
		default-on;
		status = "disabled";
	};

	lvds1_panel {
		compatible = "simple-panel";
		backlight = <&lvds1_backlight>;
		power-supply = <&reg_5v_board>;
		status = "disabled";

		display-timings {
			native-mode = <&timing1>;

			timing1: timing1 {
				clock-frequency = <71143000>;
				hactive = <1280>;
				vactive = <800>;
				hfront-porch = <120>;
				hback-porch = <2>;
				hsync-len = <8>;
				vback-porch = <10>;
				vfront-porch = <2>;
				vsync-len = <6>;
				hsync-active = <1>;
				vsync-active = <1>;
			};
		};

		port {
			panel_lvds1_in: endpoint {
				remote-endpoint = <&lvds1_out>;
			};
		};
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		/* Enabled by SMARC_CARRIER_PWR_ON (MCA) */
		reg_board_main: regulator-board-main {
			compatible = "regulator-fixed";
			regulator-name = "reg_main";
			enable-active-high;
		};

		reg_1v8_board: regulator-1v8-board {
			compatible = "regulator-fixed";
			regulator-max-microvolt = <1800000>;
			regulator-min-microvolt = <1800000>;
			regulator-name = "1v8_board";
			vin-supply = <&reg_board_main>;
		};

		reg_3v3_board: regulator-3v3-board {
			compatible = "regulator-fixed";
			regulator-max-microvolt = <3300000>;
			regulator-min-microvolt = <3300000>;
			regulator-name = "3v3_board";
			vin-supply = <&reg_board_main>;
		};

		reg_5v_board: regulator-5v-board {
			compatible = "regulator-fixed";
			regulator-max-microvolt = <5000000>;
			regulator-min-microvolt = <5000000>;
			regulator-name = "5v_board";
			vin-supply = <&reg_board_main>;
		};
	};
};

&displaymix_irqsteer {
	status = "okay";
};

&display_pixel_link {
	status = "okay";
};

&dpu {
	clocks = <&scmi_clk IMX95_CLK_DISP1PIX>,
		 <&scmi_clk IMX95_CLK_DISPAPB>,
		 <&scmi_clk IMX95_CLK_DISPAXI>,
		 <&scmi_clk IMX95_CLK_DISPOCRAM>,
		 <&scmi_clk IMX95_CLK_LDBPLL>,
		 <&scmi_clk IMX95_CLK_LDBPLL_VCO>;
	status = "okay";
};

&flexspi1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_flexspi1>;
	pinctrl-1 = <&pinctrl_flexspi1>;
	/*
	 * TODO: reset line unsupported by FlexSPI driver
	 * SMARC_ESPI_RESET# comes from MCA PA12
	 */
	status = "disabled";
};

&ldb {
	#address-cells = <1>;
	#size-cells = <0>;
	assigned-clocks = <&scmi_clk IMX95_CLK_LDBPLL_VCO>,
			  <&scmi_clk IMX95_CLK_LDBPLL>;
	assigned-clock-rates = <2988000000>, <498000000>;
	assigned-clock-parents = <0>, <&scmi_clk IMX95_CLK_LDBPLL_VCO>;
	status = "okay";

	channel@0 {
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;
		fsl,data-mapping = "jeida";
		fsl,data-width = <24>;
		status = "okay";

		port@1 {
			reg = <1>;

			lvds0_out: endpoint {
				remote-endpoint = <&panel_lvds0_in>;
			};
		};
	};

	channel@1 {
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <1>;
		fsl,data-mapping = "jeida";
		fsl,data-width = <24>;
		status = "disabled";

		port@1 {
			reg = <1>;

			lvds1_out: endpoint {
				remote-endpoint = <&panel_lvds1_in>;
			};
		};
	};
};

&ldb0_phy {
	status = "okay";
};

&ldb1_phy {
	status = "disabled";
};

&lpi2c2 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <100000>;
	status = "okay";

	lt_bridge: lt8912@48 {
		compatible = "lontium,lt8912b";
		reg = <0x48>;
		vdd-supply = <&reg_vdd_1v8_dummy>;
		vccmipirx-supply = <&reg_vdd_1v8_dummy>;
		vcchdmitx-supply = <&reg_vdd_1v8_dummy>;
		vcchdmipll-supply = <&reg_vdd_1v8_dummy>;
		vcclvdstx-supply = <&reg_vdd_1v8_dummy>;
		vccsysclk-supply = <&reg_vdd_1v8_dummy>;
		vcclvdspll-supply = <&reg_vdd_1v8_dummy>;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				lt8912_1_in: endpoint {
					data-lanes = <1 2 3 4>;
					remote-endpoint = <&mipi_dsi_hdmi_out>;
				};
			};

			port@1 {
				reg = <1>;
				lt8912_out: endpoint {
					remote-endpoint = <&hdmi_connector_in>;
				};
			};
		};
	};
};

&lpi2c4 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <100000>;
	status = "okay";

	max98089: codec@10 {
		compatible = "maxim,max98089";
		reg = <0x10>;
		clocks = <&scmi_clk IMX95_CLK_SAI3>;
		clock-names = "mclk";
		dvdd-supply = <&reg_vdd_1v8_dummy>;
		status = "disabled";
	};
};

&lpi2c7 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	status = "okay";

	ptn5110: tcpc@53 {
		compatible = "nxp,ptn5110";
		reg = <0x53>;
		interrupt-parent = <&gpio2>;
		interrupts = <7 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ptn5110>;

		port {
			typec_dr_sw: endpoint {
				remote-endpoint = <&usb3_drd_sw>;
			};
		};

		typec_con: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "dual";
			data-role = "dual";
			try-power-role = "sink";
			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
			sink-pdos = <PDO_FIXED(5000, 0, PDO_FIXED_USB_COMM)>;
			op-sink-microwatt = <0>;
			self-powered;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@1 {
					reg = <1>;
					typec_con_ss: endpoint {
						remote-endpoint = <&usb3_data_ss>;
					};
				};
			};
		};
	};
};

&lpspi1 {
	status = "disabled";

	spidev0: spi@0 {
		/*
		 * spidev uses a compatible string 'rohm,fs2228fv' to have the
		 * driver create an spi device node. This is just an example,
		 * there is not a real device connected on the SPI bus.
		 */
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

/* Console */
&lpuart1 {
	/* Errata: DMA does not work on LPUART1 */
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";
};

&lpuart3 {
	status = "disabled";
};

/*
 * LPUART5 is connected to:
 * - Bluetooth chip on wireless variants
 * - XBee on the DVK
 * Only one interface can work at a time.
 * The Bluetooth overlay has precedence over XBee.
 */
&lpuart5 {
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart5>, <&pinctrl_xbee_gpios>;
};

/* LPUART7 routed to RS485 transceiver */
&lpuart7 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart7_rs485>;
	linux,rs485-enabled-at-boot-time;
	digi,rts-gpio = <&gpio2 10 GPIO_ACTIVE_HIGH>;
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "disabled";
};

&mipi_dsi {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			mipi_dsi_hdmi_out: endpoint {
				remote-endpoint = <&lt8912_1_in>;
			};
		};
	};
};

&pixel_interleaver {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
		status = "okay";
	};

	channel@1 {
		reg = <1>;
		status = "disabled";
	};
};

&usb2 {
	/* On SMARC DVKv1 powered directly from VIN_5V */
	vbus-supply = <&reg_board_main>;
	dr_mode = "host";
	disable-over-current;
	status = "okay";
};

&usb3 {
	status = "okay";
};

&usb3_dwc3 {
	dr_mode = "otg";
	hnp-disable;
	srp-disable;
	adp-disable;
	usb-role-switch;
	role-switch-default-mode = "host";
	snps,dis-u1-entry-quirk;
	snps,dis-u2-entry-quirk;
	status = "okay";

	port {
		usb3_drd_sw: endpoint {
			remote-endpoint = <&typec_dr_sw>;
		};
	};
};

&usb3_phy {
	vbus-supply = <&reg_5v_board>;
	fsl,phy-pcs-tx-deemph-3p5db-attenuation-db = <17>;
	fsl,phy-pcs-tx-swing-full-percent = <100>;
	fsl,phy-tx-preemp-amp-tune-microamp = <600>;
	fsl,phy-tx-vboost-level-microvolt = <1156>;
	status = "okay";

	port {
		usb3_data_ss: endpoint {
			remote-endpoint = <&typec_con_ss>;
		};
	};
};

/* MicroSD */
&usdhc2 {
	vmmc-supply = <&reg_3v3_board>;
};

&wdog3 {
	status = "okay";
};

&scmi_iomuxc {
	pinctrl_lvds0_backlight: lvds0-backlightgrp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO05__GPIO2_IO_BIT5		0x31e
		>;
	};

	pinctrl_lvds1_backlight: lvds1-backlightgrp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO04__GPIO2_IO_BIT4		0x31e
		>;
	};

	pinctrl_hdmi_hpd: hdmi_hpd_grp {
		fsl,pins = <
			IMX95_PAD_PDM_CLK__AONMIX_TOP_GPIO1_IO_BIT8	0x31e
		>;
	};

	pinctrl_ptn5110: ptn5110grp {
		fsl,pins = <
			/* PTN5110 irq line (ALERT_N) line */
			IMX95_PAD_GPIO_IO07__GPIO2_IO_BIT7		0x31e
			/* PTN5110 debug irq (DBG_ACC) line */
			IMX95_PAD_ENET1_MDC__GPIO4_IO_BIT0		0x31e
		>;
	};

	pinctrl_reg_3v3_board: reg3v3grp {
		fsl,pins = <
			/* 3V3_BOARD_EN */
			IMX95_PAD_GPIO_IO34__GPIO5_IO_BIT14		0x31e
		>;
	};

	pinctrl_reg_5v_board: reg5vgrp {
		fsl,pins = <
			/* 5V_DVK_PWR_ON */
			IMX95_PAD_SAI1_RXD0__AONMIX_TOP_GPIO1_IO_BIT14	0x31e
		>;
	};

	pinctrl_reg_can1_stby: regcan1stbygrp {
		fsl,pins = <
			IMX95_PAD_SAI1_TXFS__AONMIX_TOP_GPIO1_IO_BIT11	0x31e
		>;
	};

	pinctrl_reg_can2_stby: regcan2stbygrp {
		fsl,pins = <
			IMX95_PAD_SAI1_TXD0__AONMIX_TOP_GPIO1_IO_BIT13	0x31e
		>;
	};

	pinctrl_uart7_rs485: uart7grprs485 {
		fsl,pins = <
			IMX95_PAD_GPIO_IO37__LPUART7_RX			0x31e
			IMX95_PAD_GPIO_IO36__LPUART7_TX			0x31e
			/* RS485_DE */
			IMX95_PAD_GPIO_IO10__GPIO2_IO_BIT10		0x31e
		>;
	};

	/* XBee RF IO lines */
	pinctrl_xbee_gpios: xbeegrp {
		fsl,pins = <
			/* XBEE_RESET_N */
			IMX95_PAD_SD2_RESET_B__GPIO3_IO_BIT7		0x31e
		>;
	};
};
