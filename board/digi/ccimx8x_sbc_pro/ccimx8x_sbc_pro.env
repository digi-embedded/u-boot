#include <env/digi/common.env>
#include <env/digi/mmc.env>

#define BOARD_DEY_NAME	ccimx8x-sbc-pro

active_system=linux_a
altbootcmd=
	if test ${dualboot} = yes; then
		if test ${active_system} = linux_a; then
			setenv active_system linux_b;
		else
			setenv active_system linux_a;
		fi;
		saveenv;
		echo "## System boot failed; Switching active partitions bank to ${active_system}...";
	fi;
	bootcount reset;
	reset;
boot_fdt=try
bootargs_mmc_android=setenv bootargs console=${console},${baudrate} ${bootargs_android} ${bootargs_once} ${extra_bootargs}
bootargs_mmc_linux=setenv bootargs console=${console},${baudrate} ${bootargs_linux} root=${mmcroot} rootwait rw ${bootargs_once} ${extra_bootargs}
bootargs_nfs_linux=run bootargs_tftp_linux
bootargs_tftp=
	if test ${ip_dyn} = yes; then
		bootargs_ip="ip=dhcp";
	else
		bootargs_ip="ip=${ipaddr}:${serverip}:${gatewayip}:${netmask}:${hostname}:eth0:off";
	fi;
bootargs_tftp_linux=run bootargs_tftp; setenv bootargs console=${console},${baudrate} ${bootargs_linux} root=/dev/nfs ${bootargs_ip} nfsroot=${serverip}:${rootpath},v3,tcp ${bootargs_once} ${extra_bootargs}
bootcmd_mfg=fastboot CONFIG_FASTBOOT_USB_DEV
console=ttyLP2
dboot_kernel_var=imagegz
dualboot=no
earlycon=lpuart32,0x5a080000
emmc_dev=0
fastboot_dev=mmc0
fdt_addr=0x8B000000
fdt_file=DEFAULT_FDT_FILE
image=Image-BOARD_DEY_NAME.bin
imagegz=Image.gz-BOARD_DEY_NAME.bin
initrd_addr=0x8B100000
initrd_high=0xffffffffffffffff
install_android_fw_sd=
	if load mmc 1 ${loadaddr} install_android_fw_sd.scr; then
		source ${loadaddr};
	fi;
install_linux_fw_sd=
	if load mmc 1 ${loadaddr} install_linux_fw_sd.scr; then
		source ${loadaddr};
	fi;
install_linux_fw_usb=
	usb start;
	if load usb 0 ${loadaddr} install_linux_fw_usb.scr; then
		source ${loadaddr};
	fi;
ip_dyn=yes
linux_file=dey-image-qt-xwayland-BOARD_DEY_NAME.boot.vfat
loadbootscript=
	if test "${mmcbootdev}" = "${sd_dev}"; then
		part number mmc ${mmcbootdev} boot mmcpart;
	elif test "${dualboot}" = yes; then
		env exists active_system || setenv active_system linux_a;
		part number mmc ${mmcbootdev} ${active_system} mmcpart;
	fi;
	load mmc ${mmcbootdev}:${mmcpart} ${loadaddr} ${script}
loadfdt=load mmc ${mmcdev}:${mmcpart} ${fdt_addr} ${fdt_file}
loadimage=load mmc ${mmcdev}:${mmcpart} ${loadaddr} ${image}
lzipaddr=CONFIG_DIGI_LZIPADDR
mmcargs=setenv bootargs console=${console},${baudrate} root=${mmcroot}
mmcautodetect=yes
mmcbootpart=1
mmcdev=0
mmcpart=1
mmcroot=PARTUUID=1c606ef5-f1ac-43b9-9bb5-d5c578580b6b
panel=NULL
partition_mmc_linux=
	mmc rescan;
	if mmc dev ${mmcdev}; then
		if test "${dualboot}" = yes; then
			gpt write mmc ${mmcdev} ${parts_linux_dualboot};
		else
			gpt write mmc ${mmcdev} ${parts_linux};
		fi;
		mmc rescan;
	fi;
recovery_file=recovery.img
recoverycmd=setenv mmcpart 2; boot
rootfs_file=dey-image-qt-xwayland-BOARD_DEY_NAME.ext4
script=boot.scr
sd_dev=1
splashimage=0x9e000000
splashpos=m,m
uboot_file=imx-boot-BOARD_DEY_NAME.bin
update_addr=CONFIG_DIGI_UPDATE_ADDR
usb_pgood_delay=2000
